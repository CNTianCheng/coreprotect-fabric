{
  "schemaVersion": 1,
  "id": "coreprotect",
  "version": "${version}",
  "name": "CoreProtect Fabric",
  "description": "CoreProtect-style block/container logging, rollback, restore, lookup and inspection for Fabric servers. 多语言支持 (EN/简体中文/繁體中文/日本語/Русский).",
  "authors": [
    "CoreProtect Fabric Contributors"
  ],
  "contact": {
    "homepage": "https://github.com/CNTianCheng/coreprotect-fabric",
    "sources": "https://github.com/CNTianCheng/coreprotect-fabric",
    "issues": "https://github.com/CNTianCheng/coreprotect-fabric/issues"
  },
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.coreprotect.fabric.CoreProtectFabric"
    ]
  },
  "mixins": [
    "coreprotect.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "fabric-api": "*",
    "minecraft": "26.1.2",
    "java": ">=25"
  }
}

